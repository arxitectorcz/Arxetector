-- ПЕРЕМЕННЫЕ СОСТОЯНИЯ
local spamLoop = false
local lagLoop = nil
local hijackConnection = nil

-- ФУНКЦИИ УПРАВЛЕНИЯ
local Commands = {}

-- 1. Управление жизнью
function Commands.kill()
    Humanoid.Health = 0
    logToDiscord("Kill", "Персонаж обнулен")
end

function Commands.kick(reason)
    logToDiscord("Kick", "Причина: " .. reason)
    LocalPlayer:Kick(reason)
end

function Commands.rejoin()
    logToDiscord("Rejoin", "Перезаход на сервер")
    TeleportService:Teleport(game.PlaceId, LocalPlayer)
end

function Commands.tp_to(targetName)
    local target = Players:FindFirstChild(targetName)
    if target and target.Character then
        Character:MoveTo(target.Character.HumanoidRootPart.Position)
        logToDiscord("TP", "Телепорт к " .. targetName)
    end
end

-- 2. Параметры персонажа
function Commands.speed(value)
    Humanoid.WalkSpeed = value
end

function Commands.jump(value)
    Humanoid.JumpPower = value
end

function Commands.fire()
    local f = Instance.new("Fire", Character.HumanoidRootPart)
    f.Name = "EffectFire"
end

function Commands.unfire()
    if Character.HumanoidRootPart:FindFirstChild("EffectFire") then
        Character.HumanoidRootPart.EffectFire:Destroy()
    end
end

-- 3. Эффекты
function Commands.message(text)
    local gui = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
    local txt = Instance.new("TextLabel", gui)
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.TextColor3 = Color3.new(1, 0, 0)
    txt.TextScaled = true
    txt.Text = text
    logToDiscord("Message", text)
    task.wait(5)
    gui:Destroy()
end

function Commands.lag()
    lagLoop = RunService.Heartbeat:Connect(function()
        for i = 1, 1000000 do -- Искусственная нагрузка
            local _ = math.sqrt(i)
        end
    end)
    logToDiscord("Lag", "Активирована нагрузка ЦП")
end

function Commands.unlag()
    if lagLoop then lagLoop:Disconnect() end
end

-- 4. Троллинг
function Commands.hijack(targetName)
    local target = Players:FindFirstChild(targetName)
    if target and target.Character then
        hijackConnection = RunService.RenderStepped:Connect(function()
            Character:MoveTo(target.Character.HumanoidRootPart.Position + Vector3.new(2, 0, 2))
        end)
        logToDiscord("Hijack", "Слежка за " .. targetName)
    end
end

function Commands.unhijack()
    if hijackConnection then hijackConnection:Disconnect() end
end

function Commands.chat_spam(text)
    spamLoop = true
    logToDiscord("Spam", "Начат спам: " .. text)
    task.spawn(function()
        while spamLoop do
            game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(text, "All")
            task.wait(0.1)
        end
    end)
end

function Commands.stop_spam()
    spamLoop = false
end

-- Режим Safe
function Commands.safe()
    print("System in standby mode...")
end

