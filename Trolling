                    sendLog("🌑 ХОРРОР", "Тьма и звуки")

                elseif string.find(cmd, "kick") then
                    local r = string.match(cmd, "%((.*)%)") or "Disconnected"
                    lp:Kick("\n[AxM Security]\n" .. r)
                end
            end
        end)
    end
end)

