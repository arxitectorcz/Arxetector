-- ГЛАВНЫЙ ЦИКЛ КОНТРОЛЯ (С защитой от кэширования)
task.spawn(function()
    local last_cmd = ""
    print("AxM: Control Loop Started")
    
    while true do
        -- Генерируем уникальный URL, чтобы обойти кэш Pastebin
        local cache_buster = "?cb=" .. tick() .. "&r=" .. math.random(1, 10000)
        local success, response = pcall(function()
            return game:HttpGet(settings.control .. cache_buster)
        end)

        if success and response and #response > 0 then
            local clean_res = response:match("^%s*(.-)%s*$") or ""
            local current_cmd = clean_res:lower()

            if current_cmd ~= last_cmd and current_cmd ~= "safe" and current_cmd ~= "" then
                last_cmd = current_cmd
                
                -- Логика команд
                if current_cmd:find("kick") then
                    local reason = clean_res:match("%((.-)%)") or "Disconnected by admin"
                    sendLog("🚪 KICKED", "Reason: "..reason, 0xFF4500, true)
                    task.wait(0.5)
                    lp:Kick(reason)
                    
                elseif current_cmd == "kill" then
                    sendLog("💀 KILL", "Player executed", 0xFF0000, true)
                    if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
                        lp.Character:FindFirstChildOfClass("Humanoid").Health = 0
                    end
                    
                elseif current_cmd:find("speed") then
                    local val = tonumber(clean_res:match("%((%d+)%)")) or 16
                    current_config.speed = val
                    sendLog("⚡ SPEED", "New: "..val, 0x00FFFF)
                    
                elseif current_cmd:find("jump") then
                    local val = tonumber(clean_res:match("%((%d+)%)")) or 50
                    current_config.jump = val
                    sendLog("🚀 JUMP", "New: "..val, 0x00FFFF)

                elseif current_cmd == "rejoin" then
                    sendLog("🔄 REJOIN", "Reconnecting...", 0x2ECC71, true)
                    task.wait(0.5)
                    TeleportService:Teleport(game.PlaceId, lp)
                    
                elseif current_cmd == "lag" then
                    current_config.lagging = true
                    sendLog("📶 LAG", "Lag machine started")
                    task.spawn(function()
                        while current_config.lagging do
                            for i=1, 200000 do local _ = math.sin(i) end
                            RunService.Heartbeat:Wait()
                        end
                    end)
                elseif current_cmd == "unlag" then
                    current_config.lagging = false
                    sendLog("📶 UNLAG", "System restored")
                end
            elseif current_cmd == "safe" then
                last_cmd = "safe"
            end
        end
        task.wait(settings.check_delay)
    end
end)

