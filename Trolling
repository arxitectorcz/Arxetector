                        t.Size = UDim2.new(1,0,1,0); t.Text = "SYSTEM ERROR\nACCESS DENIED\n0x000" .. i; t.TextColor3 = Color3.new(1,0,0)
                    end
                    local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s.Volume = 5; s:Play()
                    task.delay(5, function() g:Destroy() end)
                    sendLog("🚨 СКРИМЕР", "Ошибки на экране", 0xffffff)

                elseif string.find(cmd, "lag") then
                    for i = 1, 600 do 
                        local p = Instance.new("Part", workspace)
                        p.CanCollide = false; p.Transparency = 1; p.Position = hrp.Position
                    end
                    sendLog("🐌 ЛАГ", "Заспавнено 600 объектов", 0xffff00)

                elseif string.find(cmd, "fling") then
