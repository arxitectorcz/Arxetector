local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

-- ================= [ НАСТРОЙКИ ] =================
local GIST_URL = "https://gist.githubusercontent.com/arxitectorcz/fa2e7f22f682569b974a71810463d388/raw/"
local WEBHOOK_URL = "https://discord.com/api/webhooks/1465626358351794206/Vd6C9UGjjUhiH5xUdy1rv2AbwPwRqQIHrozSDyW1a0k5VoNd2k_-d2U3PgurZVkRMbl0"
-- =================================================

local LocalPlayer = Players.LocalPlayer
local lastCommand = ""

-- Функция логирования в Discord
local function logToDiscord(text)
    local data = {
        ["embeds"] = {{
            ["title"] = "🛠 Gist Command Executed",
            ["description"] = "**Команда:** `" .. text .. "`\n**Игрок:** " .. LocalPlayer.Name,
            ["color"] = 0xF1C40F -- Желтый
        }}
    }
    pcall(function()
        HttpService:PostAsync(WEBHOOK_URL, HttpService:JSONEncode(data))
    end)
end

-- Обработчик команд
local function execute(text)
    if text == "" or text == nil then return end
    
    local args = string.split(text, " ")
    local cmd = args[1]:lower()
    local val = args[2]
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    if not hum then return end

    if cmd == "kill" then
        hum.Health = 0
    elseif cmd == "speed" then
        hum.WalkSpeed = tonumber(val) or 16
    elseif cmd == "jump" then
        hum.JumpPower = tonumber(val) or 50
    elseif cmd == "rejoin" then
        TeleportService:Teleport(game.PlaceId, LocalPlayer)
    elseif cmd == "kick" then
        LocalPlayer:Kick(val or "Remote Kick")
    elseif cmd == "fire" then
        if not char.HumanoidRootPart:FindFirstChild("GistFire") then
            Instance.new("Fire", char.HumanoidRootPart).Name = "GistFire"
        end
    elseif cmd == "unfire" then
        local f = char.HumanoidRootPart:FindFirstChild("GistFire")
        if f then f:Destroy() end
    elseif cmd == "message" then
        print("MESSAGE FROM GIST: " .. (val or "empty"))
    end
    
    logToDiscord(text)
end

print("🛰 Система Gist-Control запущена...")

while true do
    -- Добавляем случайное число в конец ссылки, чтобы Roblox не читал кэш (старую версию)
    local success, currentCommand = pcall(function()
        return game:HttpGet(GIST_URL .. "?t=" .. math.random(1, 100000))
    end)

    if success then
        -- Убираем лишние пробелы
        currentCommand = currentCommand:match("^%s*(.-)%s*$")
        
        if currentCommand ~= lastCommand and currentCommand ~= "" then
            print("Новая команда: " .. currentCommand)
            lastCommand = currentCommand
            execute(currentCommand)
        end
    else
        warn("Ошибка при чтении Gist. Проверь интернет или ссылку.")
    end
    
    task.wait(4) -- Проверка каждые 4 секунды
end
