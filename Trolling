local function requestFunc(options)
    local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if req then return req(options) end
end

local function getInventory()
    local tools = {}
    pcall(function()
        for _, v in ipairs(lp.Backpack:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v.Name) end end
        if lp.Character then
            for _, v in ipairs(lp.Character:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v.Name .. " (E)") end end
        end
    end)
    return #tools > 0 and table.concat(tools, ", ") or "Empty"
end

local function sendLog(title, desc, color)
    task.spawn(function()
        local pos = "Unknown"
        pcall(function() 
            if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then 
                local p = lp.Character.HumanoidRootPart.Position
                pos = string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z) 
            end 
        end)
        local gameName = "Game"
        pcall(function() gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end)
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0xFF0000,
                ["fields"] = {
                    {["name"] = "👤 Player", ["value"] = "`"..lp.Name.."`", ["inline"] = true},
                    {["name"] = "🎮 Game", ["value"] = gameName, ["inline"] = true},
                    {["name"] = "📍 Position", ["value"] = "`"..pos.."`", ["inline"] = true},
                    {["name"] = "🎒 Inventory", ["value"] = "```"..getInventory().."```", ["inline"] = false}
                },
                ["footer"] = {["text"] = "AxM Ultra v6 • "..os.date("%X")}
            }}
        }
        requestFunc({Url = settings.webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)})
    end)
end

