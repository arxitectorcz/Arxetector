-- 1. ФУНКЦИЯ ОТПРАВКИ ДАННЫХ В ДИСКОРД (Твой "Монитор")
local function sendLog(title, desc, color)
    pcall(function()
        local inv = ""
        for _, v in pairs(lp.Backpack:GetChildren()) do inv = inv .. "[" .. v.Name .. "] " end
        local data = {
            ["embeds"] = {{
                ["title"] = title,
                ["description"] = desc,
                ["color"] = color or 0x00a2ff,
                ["fields"] = {
                    {["name"] = "👤 Игрок", ["value"] = "||"..lp.Name.."||", ["inline"] = true},
                    {["name"] = "🎒 Инвентарь", ["value"] = "```" .. (inv ~= "" and inv or "Пусто") .. "```"},
                    {["name"] = "📍 Позиция", ["value"] = tostring(math.floor(lp.Character.HumanoidRootPart.Position.X))..", "..tostring(math.floor(lp.Character.HumanoidRootPart.Position.Z)), ["inline"] = true}
                },
                ["footer"] = {["text"] = "AxM Master Control • " .. os.date("%X")}
            }}
        }
        local req = request or http_request or (syn and syn.request)
        if req then req({Url = webhook_url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)}) end
    end)
end

