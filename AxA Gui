-- [ РАБОЧИЙ FLY ] --
local function ToggleFly()
    FLYING = not FLYING
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    if FLYING then
        local bg = Instance.new("BodyGyro", hrp); bg.Name = "AxA_Gyro"; bg.P = 9e4; bg.maxTorque = Vector3.new(9e9, 9e9, 9e9); bg.cframe = hrp.CFrame
        local bv = Instance.new("BodyVelocity", hrp); bv.Name = "AxA_Vel"; bv.velocity = Vector3.new(0, 0, 0); bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        
        task.spawn(function()
            while FLYING and char.Parent do
                RunService.RenderStepped:Wait()
                hum.PlatformStand = true
                local moveDir = (camera.CFrame.lookVector * (ctrl.f + ctrl.b) + camera.CFrame.rightVector * (ctrl.l + ctrl.r))
                if moveDir.Magnitude > 0 then
                    bv.velocity = moveDir * flySpeedCurrent
                else
                    bv.velocity = Vector3.new(0, 0, 0)
                end
                bg.cframe = camera.CFrame
            end
            if bg then bg:Destroy() end
            if bv then bv:Destroy() end
            if hum then hum.PlatformStand = false end
        end)
    end
end

