-- ЛОГИКА AxA FLY
local ctrl = {f = 0, b = 0, l = 0, r = 0}
local lastctrl = {f = 0, b = 0, l = 0, r = 0}
local maxspeed = 1000
local flySpeedCurrent = 50
local flyBtn

local function ToggleFly(state, customSpeed)
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local torso = char.HumanoidRootPart
    
    FLYING = (state ~= nil) and state or not FLYING
    if customSpeed then flySpeedCurrent = customSpeed end
    if flyBtn then flyBtn.Text = FLYING and "FLY: [ON]" or "FLY: [OFF]" end

    if FLYING then
        if torso:FindFirstChild("AxA_Gyro") then torso.AxA_Gyro:Destroy() end
        if torso:FindFirstChild("AxA_Vel") then torso.AxA_Vel:Destroy() end

        local bg = Instance.new("BodyGyro", torso)
        bg.Name = "AxA_Gyro"
        bg.P = 9e4
        bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.cframe = torso.CFrame
        
        local bv = Instance.new("BodyVelocity", torso)
        bv.Name = "AxA_Vel"
        bv.velocity = Vector3.new(0, 0.1, 0)
        bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        
        task.spawn(function()
            repeat RunService.RenderStepped:Wait()
                if not lp.Character or not lp.Character:FindFirstChild("Humanoid") then break end
                lp.Character.Humanoid.PlatformStand = true
                
                if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
                    flySpeedCurrent = math.min(flySpeedCurrent + 0.5 + (flySpeedCurrent / maxspeed), maxspeed)
                    bv.velocity = ((camera.CFrame.lookVector * (ctrl.f + ctrl.b)) + ((camera.CFrame * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * 0.2, 0).p) - camera.CFrame.p)) * flySpeedCurrent
                    lastctrl = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
                else
                    bv.velocity = Vector3.new(0, 0.1, 0)
                end
                bg.cframe = camera.CFrame
            until not FLYING
            if bg then bg:Destroy() end
            if bv then bv:Destroy() end
            if lp.Character and lp.Character:FindFirstChild("Humanoid") then
                lp.Character.Humanoid.PlatformStand = false
            end
        end)
    end
end

