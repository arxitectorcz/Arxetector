    [🚀] AxM ULTRA MOBILE (FIXED)
    [🛰️] FLY: ANCHORED CFRAME (WORKS ON ALL PHONES)
    [⚡] NO PHYSICS - NO BUGS
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer
local camera = workspace.CurrentCamera

local ScreenGui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
ScreenGui.Name = "AxM_Universal"
ScreenGui.ResetOnSpawn = false

local FLYING = false
local flySpeed = 1.5
local noclip = false

-- ГЛАВНОЕ ОКНО
local mainFrame = Instance.new("Frame", ScreenGui)
mainFrame.Size = UDim2.new(0, 180, 0, 300)
mainFrame.Position = UDim2.new(0.5, -90, 0.5, -150)
mainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
mainFrame.BorderSizePixel = 0
mainFrame.Visible = false
mainFrame.Active = true
mainFrame.Draggable = true
Instance.new("UICorner", mainFrame)

local function addButton(text, callback)
    local btn = Instance.new("TextButton", mainFrame)
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, #mainFrame:GetChildren() * 40)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 50)
    btn.Text = text
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = "GothamBold"
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

local flyBtn = addButton("FLY: OFF", function()
    FLYING = not FLYING
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.Anchored = FLYING end -- Замораживаем физику
end)

addButton("NOCLIP: OFF", function() noclip = not noclip end)

-- ЛОГИКА ПОЛЕТА (CFRAME ANCHORED)
RunService.RenderStepped:Connect(function()
    if FLYING and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = lp.Character.HumanoidRootPart
        local hum = lp.Character:FindFirstChildOfClass("Humanoid")
        
        hrp.Anchored = true
        flyBtn.Text = "FLY: ON"
        
        -- Куда смотрим
        local look = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector
        local moveDir = hum.MoveDirection -- Считываем джойстик
        
        if moveDir.Magnitude > 0 then
            -- Вычисляем новую позицию на основе джойстика и камеры
            local direction = (camera.CFrame.LookVector * (moveDir.Z * -1)) + (camera.CFrame.RightVector * moveDir.X)
            hrp.CFrame = hrp.CFrame + (direction * flySpeed)
        end
    elseif not FLYING and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        lp.Character.HumanoidRootPart.Anchored = false
        flyBtn.Text = "FLY: OFF"
    end
    
    -- Ноклип
    if noclip and lp.Character then
        for _, v in pairs(lp.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)

-- КОМАНДЫ ЧАТА
lp.Chatted:Connect(function(msg)
    if msg:lower() == "fly" then FLYING = true
    elseif msg:lower() == "unfly" then FLYING = false end
end)

-- КНОПКА AxM
local tBtn = Instance.new("TextButton", ScreenGui)
tBtn.Size = UDim2.new(0, 50, 0, 50)
tBtn.Position = UDim2.new(0, 10, 0.5, 0)
tBtn.Text = "AxM"
tBtn.BackgroundColor3 = Color3.new(1, 0.8, 0)
Instance.new("UICorner", tBtn).CornerRadius = UDim.new(1, 0)
tBtn.MouseButton1Click:Connect(function() mainFrame.Visible = not mainFrame.Visible end)
