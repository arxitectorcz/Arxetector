-- ЛОГИКА НОВОГО ФЛАЯ (BODYVELOCITY)
local ctrl = {f = 0, b = 0, l = 0, r = 0}
local lastctrl = {f = 0, b = 0, l = 0, r = 0}
local maxspeed = 1000
local flySpeedCurrent = 50

local function ToggleFly()
    local char = lp.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local torso = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    FLYING = not FLYING
    
    if FLYING then
        local bg = Instance.new("BodyGyro", torso)
        bg.P = 9e4
        bg.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.cframe = torso.CFrame
        
        local bv = Instance.new("BodyVelocity", torso)
        bv.velocity = Vector3.new(0, 0.1, 0)
        bv.maxForce = Vector3.new(9e9, 9e9, 9e9)
        
        task.spawn(function()
            repeat RunService.RenderStepped:Wait()
                hum.PlatformStand = true
                
                if ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0 then
                    flySpeedCurrent = flySpeedCurrent + 0.5 + (flySpeedCurrent / maxspeed)
                    if flySpeedCurrent > maxspeed then flySpeedCurrent = maxspeed end
                elseif not (ctrl.l + ctrl.r ~= 0 or ctrl.f + ctrl.b ~= 0) and flySpeedCurrent ~= 0 then
                    flySpeedCurrent = flySpeedCurrent - 1
                    if flySpeedCurrent < 0 then flySpeedCurrent = 0 end
                end
                
                if (ctrl.l + ctrl.r) ~= 0 or (ctrl.f + ctrl.b) ~= 0 then
                    bv.velocity = ((camera.CFrame.lookVector * (ctrl.f + ctrl.b)) + ((camera.CFrame * CFrame.new(ctrl.l + ctrl.r, (ctrl.f + ctrl.b) * 0.2, 0).p) - camera.CFrame.p)) * flySpeedCurrent
                    lastctrl = {f = ctrl.f, b = ctrl.b, l = ctrl.l, r = ctrl.r}
                elseif (ctrl.l + ctrl.r) == 0 and (ctrl.f + ctrl.b) == 0 and flySpeedCurrent ~= 0 then
                    bv.velocity = ((camera.CFrame.lookVector * (lastctrl.f + lastctrl.b)) + ((camera.CFrame * CFrame.new(lastctrl.l + lastctrl.r, (lastctrl.f + lastctrl.b) * 0.2, 0).p) - camera.CFrame.p)) * flySpeedCurrent
                else
                    bv.velocity = Vector3.new(0, 0.1, 0)
                end
                bg.cframe = camera.CFrame * CFrame.Angles(-math.rad((ctrl.f + ctrl.b) * 50 * flySpeedCurrent / maxspeed), 0, 0)
            until not FLYING
            
            bg:Destroy()
            bv:Destroy()
            hum.PlatformStand = false
            flySpeedCurrent = 50
        end)
    end
end

-- Управление Fly (WASD + Mobile Direction)
RunService.RenderStepped:Connect(function()
    if FLYING and lp.Character and lp.Character:FindFirstChildOfClass("Humanoid") then
        local moveDir = lp.Character.Humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            ctrl.f = (camera.CFrame.LookVector:Dot(moveDir) > 0) and 1 or -1
        else
            -- Если не на ПК, сбрасываем ввод если джойстик стоит
            if UserInputService.TouchEnabled then ctrl.f = 0 ctrl.b = 0 end
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.W then ctrl.f = 1
    elseif input.KeyCode == Enum.KeyCode.S then ctrl.b = -1
    elseif input.KeyCode == Enum.KeyCode.A then ctrl.l = -1
    elseif input.KeyCode == Enum.KeyCode.D then ctrl.r = 1
    elseif input.KeyCode == Enum.KeyCode.E then ToggleFly() end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then ctrl.f = 0
    elseif input.KeyCode == Enum.KeyCode.S then ctrl.b = 0
    elseif input.KeyCode == Enum.KeyCode.A then ctrl.l = 0
    elseif input.KeyCode == Enum.KeyCode.D then ctrl.r = 0 end
end)

