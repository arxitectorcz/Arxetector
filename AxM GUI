-- [МОДУЛИ]

-- 1. TP TO PLAYER
addButton("TP TO PLAYER").MouseButton1Click:Connect(function()
    local target = nameBox.Text:lower()
    for _, v in pairs(Players:GetPlayers()) do
        if v.Name:lower():sub(1, #target) == target and v.Character then
            lp.Character:MoveTo(v.Character.HumanoidRootPart.Position)
            break
        end
    end
end)

-- 2. CONSTANT BYPASS SPEED
local speedActive = false
local speedPower = 2.2 -- Множитель скорости
local sBtn = addButton("SPEED: [OFF]")
sBtn.MouseButton1Click:Connect(function()
    speedActive = not speedActive
    sBtn.Text = speedActive and "SPEED: [ON]" or "SPEED: [OFF]"
end)

-- 3. SUPREME DIRECTIONAL FLY
local flying = false
local flyBtn = addButton("FLY: [OFF]")
flyBtn.MouseButton1Click:Connect(function()
    flying = not flying
    flyBtn.Text = flying and "FLY: [ON]" or "FLY: [OFF]"
    if flying then
        local bv = Instance.new("BodyVelocity", lp.Character.HumanoidRootPart)
        bv.Name = "AS_Fly_Core"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0,0,0)
        
        task.spawn(function()
            while flying do
                RunService.RenderStepped:Wait()
                if lp.Character and lp.Character:FindFirstChild("Humanoid") then
                    -- Направление взгляда камеры
                    local look = camera.CFrame.LookVector
                    local move = lp.Character.Humanoid.MoveDirection
                    
                    -- Если джойстик/WASD нажат, летим в сторону взгляда
                    if move.Magnitude > 0 then
                        bv.Velocity = camera.CFrame:VectorToWorldSpace(lp.Character.Humanoid.MoveDirection) * 80
                    else
                        bv.Velocity = Vector3.new(0, 0, 0)
                    end
                end
            end
            if bv then bv:Destroy() end
        end)
    end
end)

