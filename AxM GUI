--[[ 
    [🚀] AxM SUPREME MOBILE FINAL
    [🛰️] FLY: PHYSICAL VELOCITY (STABLE)
    [🎮] CONTROLS: JOYSTICK + UP/DOWN BUTTONS
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local lp = Players.LocalPlayer
local camera = workspace.CurrentCamera

local ScreenGui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
ScreenGui.Name = "AxM_Mobile_Ultimate"
ScreenGui.ResetOnSpawn = false

local FLYING = false
local flySpeed = 50
local noclip = false

-- Состояния управления
local moveState = {F = 0, B = 0, L = 0, R = 0, UP = 0, DOWN = 0}

-- ГЛАВНОЕ ОКНО
local mainFrame = Instance.new("Frame", ScreenGui)
mainFrame.Size = UDim2.new(0, 200, 0, 300)
mainFrame.Position = UDim2.new(0.5, -100, 0.4, -150)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
mainFrame.Visible = false
Instance.new("UICorner", mainFrame)

local function createBtn(text, pos, parent, cb)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.9, 0, 0, 35)
    b.Position = pos
    b.Text = text
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 60)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = "GothamBold"
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(cb)
    return b
end

local flyBtn = createBtn("FLY: OFF", UDim2.new(0.05, 0, 0, 50), mainFrame, function()
    FLYING = not FLYING
    if not FLYING then
        if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = lp.Character.HumanoidRootPart
            if hrp:FindFirstChild("AxM_Velocity") then hrp.AxM_Velocity:Destroy() end
            if hrp:FindFirstChild("AxM_Gyro") then hrp.AxM_Gyro:Destroy() end
            lp.Character.Humanoid.PlatformStand = false
        end
    end
end)

-- КНОПКИ УПРАВЛЕНИЯ ВЫСОТОЙ (ТОЛЬКО ДЛЯ МОБИЛОК)
local controlFrame = Instance.new("Frame", ScreenGui)
controlFrame.Size = UDim2.new(0, 60, 0, 130)
controlFrame.Position = UDim2.new(1, -70, 0.5, -65)
controlFrame.BackgroundTransparency = 1

local upBtn = Instance.new("TextButton", controlFrame)
upBtn.Size = UDim2.new(1, 0, 0.45, 0)
upBtn.Text = "UP"
upBtn.BackgroundColor3 = Color3.new(0, 0.5, 1)
Instance.new("UICorner", upBtn)

local downBtn = Instance.new("TextButton", controlFrame)
downBtn.Size = UDim2.new(1, 0, 0.45, 0)
downBtn.Position = UDim2.new(0, 0, 0.55, 0)
downBtn.Text = "DOWN"
downBtn.BackgroundColor3 = Color3.new(1, 0.2, 0.2)
Instance.new("UICorner", downBtn)

upBtn.InputBegan:Connect(function() moveState.UP = 1 end)
upBtn.InputEnded:Connect(function() moveState.UP = 0 end)
downBtn.InputBegan:Connect(function() moveState.DOWN = 1 end)
downBtn.InputEnded:Connect(function() moveState.DOWN = 0 end)

-- ЛОГИКА ПОЛЕТА
RunService.RenderStepped:Connect(function()
    if FLYING and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = lp.Character.HumanoidRootPart
        local hum = lp.Character.Humanoid
        
        flyBtn.Text = "FLY: ON"
        hum.PlatformStand = true
        
        local bg = hrp:FindFirstChild("AxM_Gyro") or Instance.new("BodyGyro", hrp)
        bg.Name = "AxM_Gyro"
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.P = 9e4
        bg.CFrame = camera.CFrame
        
        local bv = hrp:FindFirstChild("AxM_Velocity") or Instance.new("BodyVelocity", hrp)
        bv.Name = "AxM_Velocity"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        
        local moveDir = hum.MoveDirection -- Джойстик
        local vel = Vector3.new(0, 0, 0)
        
        if moveDir.Magnitude > 0 then
            vel = moveDir * flySpeed
        end
        
        -- Добавляем подъем/спуск
        local vertical = (moveState.UP - moveState.DOWN) * flySpeed
        bv.Velocity = vel + Vector3.new(0, vertical, 0)
    end
end)

-- КНОПКА AxM
local mainBtn = Instance.new("TextButton", ScreenGui)
mainBtn.Size = UDim2.new(0, 50, 0, 50)
mainBtn.Position = UDim2.new(0, 10, 0.5, 0)
mainBtn.Text = "AxM"
mainBtn.BackgroundColor3 = Color3.new(1, 0.8, 0)
Instance.new("UICorner", mainBtn).CornerRadius = UDim.new(1, 0)
mainBtn.MouseButton1Click:Connect(function() mainFrame.Visible = not mainFrame.Visible end)

-- Ноклип (чтобы не застревать)
RunService.Stepped:Connect(function()
    if FLYING and lp.Character then
        for _, v in pairs(lp.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end)
