btnContainer.ScrollBarThickness = 0
btnContainer.CanvasSize = UDim2.new(0, 0, 2.2, 0)
Instance.new("UIListLayout", btnContainer).Padding = UDim.new(0, 5)

local function addButton(text)
    local btn = Instance.new("TextButton", btnContainer)
    btn.Size = UDim2.new(1, -6, 0, 32)
    btn.BackgroundColor3 = Color3.fromRGB(20, 40, 80)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 215, 0)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
    return btn
end

-- ПОЛЕ НИКА
local nameBox = Instance.new("TextBox", btnContainer)
