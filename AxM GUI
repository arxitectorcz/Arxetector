--[[ 
    [🚀] AxM SUPREME MOBILE EDITION
    [🛰️] FLY: CFRAME DIRECTIONAL (MOBILE FRIENDLY)
    [⚡] FEATURES: SPEED, NOCLIP, INF JUMP, AxM STICK
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")
local lp = Players.LocalPlayer
local mouse = lp:GetMouse()
local camera = workspace.CurrentCamera

local ScreenGui = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
ScreenGui.Name = "AxM_Mobile"
ScreenGui.ResetOnSpawn = false

-- ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ
local FLYING = false
local flySpeed = 2 -- Множитель скорости для CFrame
local noclip = false
local infJump = false
local speedActive = false
local speedPower = 2.2

-- ГЛАВНОЕ ОКНО AxM
local mainFrame = Instance.new("Frame", ScreenGui)
mainFrame.Size = UDim2.new(0, 220, 0, 400)
mainFrame.Position = UDim2.new(0.5, -110, 0.5, -200)
mainFrame.BackgroundColor3 = Color3.fromRGB(5, 10, 25)
mainFrame.BorderSizePixel = 0
mainFrame.Visible = false
mainFrame.Active = true
mainFrame.Draggable = true
Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 10)
local stroke = Instance.new("UIStroke", mainFrame)
stroke.Color = Color3.fromRGB(255, 215, 0)
stroke.Thickness = 2

local title = Instance.new("TextLabel", mainFrame)
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundTransparency = 1
title.Text = "AxM MOBILE"
title.Font = Enum.Font.GothamBlack
title.TextSize = 20
title.TextColor3 = Color3.fromRGB(255, 215, 0)

local btnContainer = Instance.new("ScrollingFrame", mainFrame)
btnContainer.Size = UDim2.new(1, -20, 1, -60)
btnContainer.Position = UDim2.new(0, 10, 0, 50)
btnContainer.BackgroundTransparency = 1
btnContainer.ScrollBarThickness = 2
btnContainer.CanvasSize = UDim2.new(0, 0, 2, 0)
Instance.new("UIListLayout", btnContainer).Padding = UDim.new(0, 8)

local function addButton(text)
	local btn = Instance.new("TextButton", btnContainer)
	btn.Size = UDim2.new(1, 0, 0, 40)
	btn.BackgroundColor3 = Color3.fromRGB(20, 40, 80)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 215, 0)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 14
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	return btn
end

-- КНОПКИ
local flyBtn = addButton("FLY: [OFF]")
flyBtn.MouseButton1Click:Connect(function()
    FLYING = not FLYING
    flyBtn.Text = FLYING and "FLY: [ON]" or "FLY: [OFF]"
end)

local sBtn = addButton("SPEED: [OFF]")
sBtn.MouseButton1Click:Connect(function()
	speedActive = not speedActive
	sBtn.Text = speedActive and "SPEED: [ON]" or "SPEED: [OFF]"
end)

local nBtn = addButton("NOCLIP: [OFF]")
nBtn.MouseButton1Click:Connect(function() 
    noclip = not noclip 
    nBtn.Text = noclip and "NOCLIP: [ON]" or "NOCLIP: [OFF]" 
end)

local ijBtn = addButton("INF JUMP: [OFF]")
ijBtn.MouseButton1Click:Connect(function()
    infJump = not infJump
    ijBtn.Text = infJump and "INF JUMP: [ON]" or "INF JUMP: [OFF]"
end)

local fbBtn = addButton("VISION: [OFF]")
local fb = false
fbBtn.MouseButton1Click:Connect(function()
	fb = not fb
	fbBtn.Text = fb and "VISION: [ON]" or "VISION: [OFF]"
	Lighting.Brightness = fb and 2 or 1
	Lighting.OutdoorAmbient = fb and Color3.new(1,1,1) or Color3.new(0.5,0.5,0.5)
end)

addButton("AxM STICK (GET)").MouseButton1Click:Connect(function()
    local tool = Instance.new("Tool", lp.Backpack)
    tool.Name = "AxM Stick"
    local handle = Instance.new("Part", tool)
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.4, 4, 0.4)
    handle.Color = Color3.new(1, 1, 0)
    handle.Material = "Neon"
    tool.Activated:Connect(function()
        lp.Character:MoveTo(mouse.Hit.p)
    end)
end)

-- ЛОГИКА ОБРАБОТКИ (ДЛЯ ТЕЛЕФОНА)
RunService.Stepped:Connect(function()
    if not lp.Character or not lp.Character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = lp.Character.HumanoidRootPart
    local hum = lp.Character:FindFirstChildOfClass("Humanoid")

    -- NOCLIP
    if noclip then
        for _, v in pairs(lp.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end

    -- FLY (CFrame - идеально для мобилок)
    if FLYING then
        hum.PlatformStand = true
        local moveDir = hum.MoveDirection
        local camCFrame = camera.CFrame
        
        -- Если джойстик нажат
        if moveDir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame * CFrame.new(moveDir.X * flySpeed, (camCFrame.LookVector.Y * moveDir.Magnitude) * flySpeed, moveDir.Z * flySpeed)
        end
        -- Удержание высоты
        hrp.Velocity = Vector3.new(0, 0, 0)
    else
        if hum.PlatformStand then hum.PlatformStand = false end
    end

    -- SPEED
    if speedActive and not FLYING then
        if hum.MoveDirection.Magnitude > 0 then
            lp.Character:TranslateBy(hum.MoveDirection * speedPower)
        end
    end
end)

-- INF JUMP
UserInputService.JumpRequest:Connect(function()
    if infJump and lp.Character then
        lp.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

-- ЧАТ КОМАНДЫ (БЕЗ ПРЕФИКСА)
lp.Chatted:Connect(function(msg)
    local args = msg:lower():split(" ")
    if args[1] == "fly" then
        FLYING = true
        flySpeed = tonumber(args[2]) or 2
        flyBtn.Text = "FLY: [ON]"
    elseif args[1] == "unfly" then
        FLYING = false
        flyBtn.Text = "FLY: [OFF]"
    end
end)

-- КНОПКА ОТКРЫТИЯ AxM
local tBtn = Instance.new("TextButton", ScreenGui)
tBtn.Size = UDim2.new(0, 60, 0, 60)
tBtn.Position = UDim2.new(0, 10, 0.5, -30)
tBtn.BackgroundColor3 = Color3.fromRGB(255, 215, 0)
tBtn.Text = "AxM"
tBtn.Font = "GothamBlack"
tBtn.TextSize = 18
tBtn.TextColor3 = Color3.fromRGB(5, 15, 35)
Instance.new("UICorner", tBtn).CornerRadius = UDim.new(1, 0)

-- Перетаскивание для мобилок
local dragging, dragStart, startPos
tBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = tBtn.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        tBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function() dragging = false end)
tBtn.MouseButton1Click:Connect(function() mainFrame.Visible = not mainFrame.Visible end)
